@startuml use_case
 title Event & Volunteer Management System — Increment 1 Use Cases
 left to right direction
 skinparam shadowing false
 skinparam packageStyle rectangle
 skinparam usecase {
   BackgroundColor #E8F3FF
   BorderColor #285B86
 }
 actor User as User
 actor Administrator as Admin
 actor "Event Organizer" as Organizer
 actor Volunteer
 Admin --|> User
 Organizer --|> User
 Volunteer --|> User
 rectangle "Volunteer Management System" {
   usecase "UC01\nUser Account & Authentication" as UC01
   usecase "UC02\nUser Management & RBAC" as UC02
 }
 User -- UC01
 Admin -- UC02
@enduml
