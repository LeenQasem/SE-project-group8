@startuml SD02_High_Level_UC02_UserManagement
title SD02 - High-Level Sequence Diagram: UC02 User Management & RBAC
autonumber
actor Administrator as Admin
participant "Volunteer Management System" as System

Admin -> System : viewUsers()
activate System
alt Administrator is authorized
    System --> Admin : User list
else Administrator is not authorized
    System --> Admin : Access denied
end
deactivate System

Admin -> System : assignRole(userId, role)
activate System
alt Administrator is authorized and role is valid
    System --> Admin : User role updated
else Administrator is not authorized or role is invalid
    System --> Admin : Role assignment failed
end
deactivate System
@enduml
