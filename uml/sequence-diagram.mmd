sequenceDiagram
    actor Volunteer
    participant Frontend as React Web Frontend
    participant API as API Routes
    participant Auth as Authentication & Authorization
    participant Events as Event Management
    participant Applications as Application Management
    participant Data as Data Access
    participant DB as MySQL Database

    Volunteer->>Frontend: Browse available events
    Frontend->>API: Request available events
    API->>Events: Get events open for applications
    Events->>Data: Retrieve open events with capacity
    Data->>DB: Query available events
    DB-->>Data: Event records
    Data-->>Events: Available events
    Events-->>API: Available events
    API-->>Frontend: Available events
    Frontend-->>Volunteer: Display available events

    Volunteer->>Frontend: Select event and submit application
    Frontend->>API: Submit application (event ID)
    API->>Auth: Authenticate and authorize request
    alt Volunteer is not authenticated or authorized
        Auth-->>API: Access denied
        API-->>Frontend: Application request denied
        Frontend-->>Volunteer: Display access denied message
    else Volunteer is authenticated and authorized
        Auth-->>API: Access granted
        API->>Applications: Submit volunteer application
        Applications->>Data: Check event status and capacity
        Data->>DB: Retrieve event availability
        DB-->>Data: Event status and capacity
        Data-->>Applications: Event status and capacity
        alt Event is cancelled or full
            Applications-->>API: Reject, event unavailable
            API-->>Frontend: Application rejected
            Frontend-->>Volunteer: Display event unavailable message
        else Event is open with capacity
            Applications->>Data: Check for existing application
            Data->>DB: Find application for volunteer and event
            DB-->>Data: Existing application or none
            Data-->>Applications: Duplicate check result
            alt Volunteer has already applied
                Applications-->>API: Reject duplicate application
                API-->>Frontend: Application already exists
                Frontend-->>Volunteer: Display duplicate application message
            else Volunteer has not already applied
                Applications->>Data: Save application with Pending status
                Data->>DB: Insert Pending application
                DB-->>Data: Application saved
                Data-->>Applications: Saved application
                Applications-->>API: Application submitted (Pending)
                API-->>Frontend: Application confirmation (Pending)
                Frontend-->>Volunteer: Display application confirmation
            end
        end
    end
