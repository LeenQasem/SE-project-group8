@startuml system_context
!define C4P https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master
!includeurl C4P/C4_Context.puml
 title C4 Level 1 - System Context
Person(volunteer, "Volunteer", "Browses events, applies, views assignments, attendance and hours")
Person(organizer, "Event Organizer", "Creates events, reviews applications, assigns tasks and records attendance")
Person(admin, "Administrator", "Manages user accounts and views platform statistics")
System(evm, "Event & Volunteer Management System", "Web platform for event organization and volunteer coordination")
Rel(volunteer, evm, "Browses events, applies and tracks participation")
Rel(organizer, evm, "Manages events and volunteer participation")
Rel(admin, evm, "Administers accounts and views statistics")
@enduml