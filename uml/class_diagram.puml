@startuml EventVolunteerManagementClassDiagram
title Event & Volunteer Management System - UML Class Diagram

skinparam classAttributeIconSize 0

abstract class User {
  +int userId
  +String name
  +String email
  +String passwordHash
  +UserRole role
  +register() : boolean
  +login(email : String, password : String) : boolean
  +logout() : void
}

class Administrator {
  +manageUserAccounts() : void
  +manageOrganizers() : void
  +viewPlatformStatistics() : Report
}

class EventOrganizer {
  +createEvent(event : Event) : Event
  +editEvent(event : Event) : void
  +cancelEvent(event : Event) : void
  +reviewApplication(application : Application) : void
  +assignTask(task : Task, volunteer : Volunteer) : Task
  +recordAttendance(attendance : Attendance) : void
  +viewEventReports(event : Event) : Report[*]
}

class Volunteer {
  +browseEvents() : Event[*]
  +applyToEvent(event : Event) : Application
  +viewApplicationStatus() : Application[*]
  +viewAssignedTasks() : Task[*]
  +trackCompletedHours() : Decimal
}

class Event {
  +int eventId
  +String title
  +String description
  +DateTime date
  +String location
  +int capacity
  +EventStatus status
  +updateDetails() : void
  +cancel() : void
}

class Application {
  +int applicationId
  +DateTime appliedDate
  +ApplicationStatus status
  +approve() : void
  +reject() : void
}

class Task {
  +int taskId
  +String title
  +String description
  +TaskStatus status
  +markCompleted() : void
}

class Attendance {
  +int attendanceId
  +DateTime checkInTime
  +DateTime checkOutTime
  +Decimal hoursLogged
  +boolean isPresent
  +calculateHours() : Decimal
}

class Report {
  +int reportId
  +DateTime generatedDate
  +ReportType reportType
  +String summaryData
  +generateParticipationHistory() : Report
  +generateEventStatistics() : Report
}

enum UserRole {
  ADMINISTRATOR
  EVENT_ORGANIZER
  VOLUNTEER
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  AVAILABLE
  CANCELLED
  COMPLETED
}

enum TaskStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

enum ReportType {
  EVENT_PARTICIPATION
  PLATFORM_STATISTICS
  PARTICIPATION_HISTORY
}

User <|-- Administrator
User <|-- EventOrganizer
User <|-- Volunteer

User "1" --> "1" UserRole : has role
EventOrganizer "1" --> "0..*" Event : organizes
Volunteer "1" --> "0..*" Application : submits
Event "1" --> "0..*" Application : receives
Event "1" *-- "0..*" Task : contains
Volunteer "1" --> "0..*" Task : is assigned
Volunteer "1" --> "0..*" Attendance : has records
Event "1" --> "0..*" Attendance : attendance for
EventOrganizer "1" --> "0..*" Attendance : records
User "1" --> "0..*" Report : generates
Event "0..1" --> "0..*" Report : subject of
Application "1" --> "1" ApplicationStatus : has status
Event "1" --> "1" EventStatus : has status
Task "1" --> "1" TaskStatus : has status
Report "1" --> "1" ReportType : has type

note bottom of Task
  Assignment is permitted for approved volunteers,
  as required by FR-14. The model does not add an
  Application-to-Task association because none is specified.
end note

note bottom of Report
  A report may be platform-wide (no event subject)
  or concern one event. Status enum values beyond
  ApplicationStatus are proposed modeling values.
end note

@enduml