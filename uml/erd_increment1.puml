﻿@startuml INCREMENT_1_ERD
title Event & Volunteer Management System - Increment 1 ERD

left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #496579
skinparam ArrowThickness 1.2
skinparam entity {
  BackgroundColor #F5F8FC
  BorderColor #36536F
  FontColor #172B3A
  FontSize 13
}

entity "Role" as ROLE {
  * role_id : BIGINT <<PK>>
  --
  role_name : VARCHAR(30) <<UNIQUE>>
}

entity "User" as USER {
  * user_id : BIGINT <<PK>>
  --
  full_name : VARCHAR(150)
  email : VARCHAR(254) <<UNIQUE>>
  password_hash : VARCHAR(255)
  role_id : BIGINT <<FK>>
}

entity "UserSession" as USER_SESSION {
  * session_id : BIGINT <<PK>>
  --
  user_id : BIGINT <<FK>>
  token_hash : CHAR(64) <<UNIQUE>>
  created_at : DATETIME
  expires_at : DATETIME
  revoked_at : DATETIME
}

ROLE ||--o{ USER : assigned to
USER ||--o{ USER_SESSION : has

note top of ROLE
  Seed roles: Administrator,
  Event Organizer, Volunteer.
  Each account has exactly one role.
end note

note bottom of USER
  Public registration creates Volunteer accounts only.
  Administrator assigns privileged roles through account management.
  Store a salted, one-way password hash; never a plain-text password.
end note

legend bottom
  Increment 1 scope: accounts, authentication credentials, roles, and sessions.
  Event, Application, Task, and Attendance are introduced in later increments.
endlegend

@enduml