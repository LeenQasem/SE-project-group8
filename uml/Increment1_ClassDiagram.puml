@startuml Increment1AuthenticationUserManagement

title Event & Volunteer Management System - Increment 1 Class Diagram
left to right direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam ArrowColor #496579
skinparam class {
  BackgroundColor #F5F8FC
  BorderColor #36536F
  FontColor #172B3A
}

package "Presentation" {
  class AuthController <<boundary>> {
    - authService : AuthService
    + register(name : String, email : String, password : String) : User
    + login(email : String, password : String) : UserSession
    + logout(token : String) : void
  }
  class AdminUserController <<boundary>> {
    - userManagementService : UserManagementService
    + getAllUsers() : List<User>
    + createOrganizerAccount(name : String, email : String, password : String) : User
    + updateUserRole(userId : Long, newRole : UserRole) : User
  }
}

package "Application" {
  class AuthService <<service>> {
    - userRepository : UserRepository
    + register(name : String, email : String, password : String) : User
    + login(email : String, password : String) : UserSession
    + logout(token : String) : void
    + validateSession(token : String) : UserSession
  }
  class UserManagementService <<service>> {
    - userRepository : UserRepository
    - accessControl : AccessControlService
    + getAllUsers() : List<User>
    + createOrganizerAccount(name : String, email : String, password : String) : User
    + updateUserRole(userId : Long, newRole : UserRole) : User
  }
  class AccessControlService <<service>> {
    + authorize(user : User, requiredRoles : Set<UserRole>) : Boolean
  }
}

package "Domain" {
  class User <<entity>> {
    - id : Long
    - name : String
    - email : String
    - passwordHash : String
    - role : UserRole
    + verifyPassword(password : String) : Boolean
    + hasRole(role : UserRole) : Boolean
  }
  class UserSession <<session>> {
    + isValid() : Boolean
    + revoke() : void
  }
  enum UserRole {
    ADMINISTRATOR
    EVENT_ORGANIZER
    VOLUNTEER
  }
}

package "Data Access" {
  interface UserRepository {
    + save(user : User) : User
    + findById(id : Long) : User
    + findByEmail(email : String) : User
    + findAll() : List<User>
    + update(user : User) : User
  }
}

AuthController ..> AuthService : delegates
AdminUserController ..> UserManagementService : delegates
AuthService ..> UserRepository : uses
AuthService ..> UserSession : manages
UserManagementService ..> UserRepository : uses
UserManagementService ..> AccessControlService : authorizes
UserRepository ..> User : persists
User "1" -- "0..*" UserSession : authenticated sessions
User "0..*" --> "1" UserRole : assigned role

note right of User
  FR-01: email is unique.
  NFR-10: passwordHash stores a salted,
  one-way hash; never a plain-text password.
end note

note bottom of AuthService
  FR-02: verify credentials and start/end sessions.
  Public registration assigns VOLUNTEER per the ERD.
end note

note bottom of UserManagementService
  FR-03 / FR-20: support the three defined roles;
  administrator manages user and organizer accounts.
end note

note bottom of AccessControlService
  FR-04: authorize protected operations by role.
end note

legend bottom
  Increment 1 / v0.1.0-design scope only.
  User has one role; no AccountStatus or separate Role entity is added beyond the ERD model.
  Event, Application, Task, and Attendance are out of scope.
endlegend
@enduml
