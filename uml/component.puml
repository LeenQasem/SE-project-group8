@startuml component
!define C4P https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master
!includeurl C4P/C4_Component.puml

title C4 Level 3 — Backend Components (Increment 1: v0.1.0-design)

Container_Boundary(api, "Application Backend (Python)") {
  Component(routes, "API Routes", "Python", "Exposes HTTP endpoints and dispatches requests to Increment 1 controllers")
  Component(auth, "AuthController", "Controller", "Handles public register(), login(), and logout(); hashes passwords and sets default role VOLUNTEER")
  Component(adminUsers, "AdminUserController", "Controller", "Handles administrator-only viewUsers() and assignRole(); enforces RBAC with User.hasRole()")
  Component(userDomain, "User Domain Model", "User & UserRole", "Encapsulates user attributes, verifyPassword(), and hasRole()")
}

ContainerDb(db, "MySQL Database", "MySQL", "User records")

Rel(routes, auth, "Dispatches public authentication requests to")
Rel(routes, adminUsers, "Dispatches administrator user-management requests to")
Rel(auth, userDomain, "Uses")
Rel(adminUsers, userDomain, "Uses")
Rel(auth, db, "Reads and writes users table [SQL]")
Rel(adminUsers, db, "Reads and writes users table [SQL]")
@enduml

